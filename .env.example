# ─── PayPal (sandbox) ─────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you add a webhook pointing at https://<your-host>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# Set to true only after enabling "Log in with PayPal" on your PayPal app (Other features → Advanced Settings → Return URL)
PAYPAL_LOGIN_ENABLED=false

# ─── AI (fallback chain: Groq → Gemini → built-in rules), both free tiers ──
# Set either, both or neither. Providers without a key are skipped; if every
# provider fails or none is set, the built-in rules engine answers, so the demo always works.
# 1. Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# 2. Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─── Channel3 product catalog (optional) ─────────────────────────
CHANNEL3_API_KEY=

# ─── App ──────────────────────────────────────────────────────────
# Public URL of this deployment (used for Log in with PayPal return URL)
APP_URL=http://localhost:3000
# Payout hold window in minutes for the demo (production would use merchant return windows in days)
DEMO_HOLD_MINUTES=2
